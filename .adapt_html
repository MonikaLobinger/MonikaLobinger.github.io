#!/usr/bin/env bash
#
if [ $# -eq 0 ]; then
 echo ".adapt_html muss mit dem Argument \"domakepub\" oder \"makepriv\" aufgerufen werden"
 exit 1
fi


if [ $1 = "domakepub" ]; then
  echo ".adapt_html aufgerufen mit domakepub"
elif [ $1 = "makepriv" ]; then
  echo ".adapt_html aufgerufen mit makepriv"
else
  echo "Falsches Argument für .adapt_html"
fi


if [ $1 = "domakepub" ] || [ $1 = "makepriv" ]; then
  # Ändert den Dateibaum.
  # Für die Änderungen, die Public und Private gemeinsam sind, ist es egal, ob
  # das Original oder die Kopie geändert wird.
  #
  # Hänge im Verzeichnis Materialen in allen Katalogen (html Dateien die mit - beginnen)
  # an alle Links auf DDCKlassen, das sind hrefs zu einer Zahlenüberschrift "_0" an
  # Ist wiederholbar, denn:  hrefxyz#123\ ->  hrefxyz#123_0
  find ./materialien -type f -name "-*.html" -print0 | xargs -0 sed -i 's/\( href\S*#[0-9]*\)"/\1_0"/g'
  echo "DDCKlassen in Katalogen korrigiert"
  #
  #
  # Ersetze in allen Autoren Dateien an alle links auf timeline.html# "_0" an
  # In der zweiten Zeile korrigiere _0_0 auf _0, denn dieses Script kann auch auf
  # bereits korrigierte Dateien laufen 
  find ./materialien/autoren/ -type f -name "*.html" -print0 | xargs -0 sed -i  's/\(timeline\.html#[^/]*\)\(" class=\)/\1_0\2/'
  find ./materialien/autoren/ -type f -name "*.html" -print0 | xargs -0 sed -i  's/_0_0" class/_0" class/'
  echo "Links von Autoren auf timeline korrigiert"
  #
  #
  # Ersetze in allen Dateien Search... durch Suche...
  # Ist wiederholbar
  # Korrigiere in allen Dateien Links auf Fussnoten und Backlinks
  # Ist wiederholbar, denn ersetzt "#fn durch "filename#fn
  for f in $(find . -name '*.html' ); do
    # Ersetze  Search... durch Suche...
    sed -i 's/ placeholder="Search..."/ placeholder="Suche..."/g' $f
    #
    # Korrigiere falls vorhanden Links auf Fussnoten und Backlinks von Fußnoten
    grep -q "fnref" $f
    if [ $? -eq 0 ]; then
      fn=${f#*/}
      fn=${fn//\//\\\/}
      sed -i 's/\(<a href="\)\(#fnref-[[:digit:]]\+-[a-f[:digit:]]\+" \)/\1'"$fn"'\2/g' $f
      sed -i 's/\(" href="\)\(#fn-[[:digit:]]\+-[a-f[:digit:]]\+" \)/\1'"$fn"'\2/g' $f
      sed -i 's/"footnote-link/"xxxfootnote-link/g' $f
      sed -i 's/ footnote-link/ xxxfootnote-link/g' $f
    fi
  done
  echo "Links zu und von Fussnoten korrigiert"
  #
  #
  # Andere interne Links können nicht korrigiert werden, da die Anker in keiner
  # Weise übertragen werden.
  #
  #
  # Entferne aus dem Dateibaum nicht anzuzeigende Dateien
  # vimrc.js
  # materialien/breadcrumbs.js, materialien/catalog.js,
  # materialien/philosophie/podcasts_uni_wien, materialien/philosophie/uni_wien
  # Ist wiederholbar
  declare -a rt=("vimrc")
  for i in "${rt[@]}"; do
     sed -i 's/<div class="tree-item is-collapsed nav-file" data-depth="1"><a class="tree-item-self is-clickable nav-file-title" href="'"$i"'.js" data-path="'"$i"'.js"><div class="tree-item-inner nav-file-title-content">'"$i"'<\/div><div class="nav-file-tag">js<\/div><\/a><div class="tree-item-children nav-file-children"><\/div><\/div>//' site-lib/html/file-tree-content.html
  done
  declare -a js=("breadcrumbs" "catalog")
  for i in "${js[@]}"; do
     sed -i 's/<div class="tree-item is-collapsed nav-file" data-depth="2"><a class="tree-item-self is-clickable nav-file-title" href="materialien\/'"$i"'.js" data-path="Materialien\/'"$i"'.js"><div class="tree-item-inner nav-file-title-content">'"$i"'<\/div><div class="nav-file-tag">js<\/div><\/a><div class="tree-item-children nav-file-children"><\/div><\/div>//' site-lib/html/file-tree-content.html
  done
  declare -a mat=("podcasts_uni_wien" "uni_wien")
  for i in "${mat[@]}"; do
     sed -i 's/<div class="tree-item is-collapsed nav-file" data-depth="3"><a class="tree-item-self is-clickable nav-file-title" href="materialien\/philosophie\/'"$i"'.html" data-path="Materialien\/Philosophie\/'"$i"'.md"><div class="tree-item-inner nav-file-title-content">'"$i"'<\/div><\/a><div class="tree-item-children nav-file-children"><\/div><\/div>//' site-lib/html/file-tree-content.html
  done
  echo "Allgemein überflüssige Dateien aus dem Dateibaum gelöscht"
fi


if [ $1 = "domakepub" ]; then
  # Arbeitet auf der Kopie des Dateibaums
  # In werkstatt/ ist nun xxxstutiis/
  #
  #
  # Entferne aus dem Dateibaum nicht anzuzeigende Dateien
  # plan, show_commands, show_diagrams, show_export, show_formats show_greek, show_hotkeys show_links , show_projects  # show_styles
  declare -a md=( "plan" "show_commands" "show_diagrams" "show_export" "show_formats" "show_greek" "show_hotkeys" "show_links" "show_projects") # "show_styles"
  for i in "${md[@]}"; do
     sed -i 's/<div class="tree-item is-collapsed nav-file" data-depth="1"><a class="tree-item-self is-clickable nav-file-title" href="'"$i"'.html" data-path="'"$i"'.md"><div class="tree-item-inner nav-file-title-content">'"$i"'<\/div><\/a><div class="tree-item-children nav-file-children"><\/div><\/div>//' site-lib/html/file-tree-content.html
  done
  # PROJEKTE.md
     sed -i 's/<div class="tree-item is-collapsed nav-file" data-depth="1"><a class="tree-item-self is-clickable nav-file-title" href="projekte.html" data-path="PROJEKTE.md"><div class="tree-item-inner nav-file-title-content">PROJEKTE<\/div><\/a><div class="tree-item-children nav-file-children"><\/div><\/div>//' site-lib/html/file-tree-content.html
  # projects.html
  declare -a html=( "projects")
  for i in "${html[@]}"; do
     sed -i 's/<div class="tree-item is-collapsed nav-file" data-depth="1"><a class="tree-item-self is-clickable nav-file-title" href="'"$i"'.html" data-path="'"$i"'.html"><div class="tree-item-inner nav-file-title-content">'"$i"'<\/div><div class="nav-file-tag">html<\/div><\/a><div class="tree-item-children nav-file-children"><\/div><\/div>//' site-lib/html/file-tree-content.html
  done
  # werkstatt/-inhalt
    sed -i 's/<div class="tree-item is-collapsed nav-file" data-depth="2"><a class="tree-item-self is-clickable nav-file-title" href="werkstatt\/-inhalt.html" data-path="Werkstatt\/-inhalt.md"><div class="tree-item-inner nav-file-title-content">-inhalt<\/div><\/a><div class="tree-item-children nav-file-children"><\/div><\/div>//' site-lib/html/file-tree-content.html
  echo "Für Public überflüssige Dateien aus dem Dateibaum gelöscht"
  #
  #
  # Entferne aus dem Dateibaum nicht anzuzeigende Verzeichnisse
  # ZZZZZZ2/ mit zzzzzz2
  # Zzrojekte/ mit zzzzzz4
  # allhelperfiles/allresources/private/ mit zzzzzz3
  sed -i 's/<div class="tree-item mod-collapsible is-collapsed nav-folder" data-depth="1"><div class="tree-item-self is-clickable mod-collapsible nav-folder-title" data-path="ZZZZZZ2">.*<div class="tree-item is-collapsed nav-file" data-depth="2"><a class="tree-item-self is-clickable nav-file-title" href="zzzzzz2\/zzzzzz2.html" data-path="ZZZZZZ2\/zzzzzz2.md"><div class="tree-item-inner nav-file-title-content">zzzzzz2<\/div><\/a><div class="tree-item-children nav-file-children"><\/div><\/div><\/div><\/div>//' site-lib/html/file-tree-content.html
  sed -i 's/<div class="tree-item mod-collapsible is-collapsed nav-folder" data-depth="1"><div class="tree-item-self is-clickable mod-collapsible nav-folder-title" data-path="Zzrojekte">.*<div class="tree-item is-collapsed nav-file" data-depth="2"><a class="tree-item-self is-clickable nav-file-title" href="zzzzzz4\/zzzzzz4.html" data-path="Zzrojekte\/zzzzzz4.md"><div class="tree-item-inner nav-file-title-content">zzzzzz4<\/div><\/a><div class="tree-item-children nav-file-children"><\/div><\/div><\/div><\/div>//' site-lib/html/file-tree-content.html
  sed -i 's/<div class="tree-item mod-collapsible is-collapsed nav-folder" data-depth="3"><div class="tree-item-self is-clickable mod-collapsible nav-folder-title" data-path="allhelperfiles\/allresources\/private">.*<div class="tree-item-inner nav-file-title-content">zzzzzz3<\/div><div class="nav-file-tag">gif<\/div><\/a><div class="tree-item-children nav-file-children"><\/div><\/div><\/div><\/div>//' site-lib/html/file-tree-content.html
  echo "Für Public überflüssige Verzeichnisse aus dem Dateibaum gelöscht"
  #
  #
  # Passe den Dateibaum von Private auf Public an
  # Entferne zzzzzz1 das es als marker für die letzte Datei nur in Private gibt
  # Ersetze alle Links auf XXXstutiis durch Links auf Werkstatt
  sed -i 's/<div class="tree-item mod-collapsible is-collapsed nav-folder" data-depth="1"><div class="tree-item-self is-clickable mod-collapsible nav-folder-title" data-path="Werkstatt".*zzzzzz1<\/div><\/a><div class="tree-item-children nav-file-children"><\/div><\/div><\/div><\/div>//' site-lib/html/file-tree-content.html
  sed -i 's/XXXstutiis/Werkstatt/g' site-lib/html/file-tree-content.html
  sed -i 's/xxxstutiis/werkstatt/g' site-lib/html/file-tree-content.html
  echo "Den Dateibaum von Private auf Public angepasst"
  #
  #
  # Ersetze alle Links in html Dateien in Werkstatt von xxxstutiis auf werkstatt
  find werkstatt -type f -name "*.html" -print0 | xargs -0 sed -i 's/xxxstutiis/werkstatt/g'
  find werkstatt -type f -name "*.html" -print0 | xargs -0 sed -i 's/XXXstutiis/Werkstatt/g'
  echo "Alle Links in werkstatt von xxxstutiis auf werkstatt geändert"
  #
  #
  # Entferne aus Kopie von materialien/-materialien.html und aus Kopie von
  # materialien/philosophie/-philosophie.html
  # die Verweise im array mat. Zur Zeit:
  # materialien/philosophie/podcasts_uni_wien, materialien/philosophie/uni_wien
  # Ist wiederholbar
  if [ ! -f "materialien/-materialien.sv" ]; then
    cp "materialien/-materialien.html" "materialien/-materialien.sv"
    cp "materialien/philosophie/-philosophie.html" "materialien/philosophie/-philosophie.sv"
  fi
  if [ ! -f "site-lib/metadata.sv" ]; then
    cp "site-lib/metadata.json" "site-lib/metadata.sv"
  fi
  for i in "${mat[@]}"; do
    sed -i 's/<tr><td><span><a data-tooltip-position="top" aria-label="Materialien\/Philosophie\/'"$i"'.md" data-href="Materialien\/Philosophie\/'"$i"'.md" href="materialien\/philosophie\/'"$i"'.html" class="internal-link" target="_self" rel="noopener nofollow">Materialien\/Philosophie\/'"$i"'.md<\/a><\/span><\/td><td><span><\/span><\/td><td><span><\/span><\/td><\/tr>//' "materialien/-materialien.html"
    sed -i 's/<tr><td><span><a data-tooltip-position="top" aria-label="Materialien\/Philosophie\/'"$i"'.md" data-href="Materialien\/Philosophie\/'"$i"'.md" href="materialien\/philosophie\/'"$i"'.html" class="internal-link" target="_self" rel="noopener nofollow">Materialien\/Philosophie\/'"$i"'.md<\/a><\/span><\/td><td><span><\/span><\/td><td><span><\/span><\/td><\/tr>//' "materialien/philosophie/-philosophie.html"
  done
  echo "Public nicht vorhandene Links aus -materialien.html und -philosophie.html gelöscht."
  #
  #
  # Passe in Kopie von site-lib/metadata.json die Backlinks an:
  # - entferne alle Backlinks die mit xxxstutiis anfangen
  # - Verschiebe Backlinks mit @ von werkstatt/mitschriften/zuhoeren nach werkstatt/mitschriften
  # - entferne alle Backlinks, die mit werkstatt anfangen und nicht @ sind
  # - entferne alle Backlinks, die mit werkstatt anfangen und
  #   nicht direkt in werkstatt oder in werkstatt/mitschriften sind
  # Ist wiederholbar, da die entfernten dann ja weg sind
  python3 .korrigiere_metadata.py
  echo "Public Backlinks in metadata.json korrigiert"
  #
  #
  # Lösche in Kopie von site-lib/metadata.json alles Unnötige und dumpe die Ergebnisdatei
  # Ist wiederholbar, da die entfernten dann ja weg sind
  python3 .verkleinere_metadata.py
  python3 -c "import json, sys; print(json.dumps(json.load(sys.stdin), separators=(',', ':')))" < site-lib/metadata.json > xxx.json
  mv xxx.json site-lib/metadata.json
  echo "Public metadata.json verkleinert"
  #
  #
  # Von jeder Dateisorte eine Datei beautifien
  .beautify_json "site-lib/metadata.json" "pub"
  .css_beautify "site-lib/styles/snippets.css" "pub"
  .js_beautify "site-lib/scripts/webpage.js" "pub"
  .html_beautify "site-lib/html/file-tree-content.html" "pub"
  .html_beautify "home.html" "pub"
  echo "beautified: s-l/metadata, /styles/snippets, /scripts/webpage, /html/file-tree-content, home"

elif [ $1 = "makepriv" ]; then
  # Arbeitet auf dem Original des Dateibaums, der von Public als
  # file-tree-content.sv gesichert wird
  # und von Private als file-tree-content.html verwendet wird.
  # In werkstatt/ ist nun Privat/
  # xxxstutiis/ ist sichtbar
  #
  #
  # Stelle die Originale von materialien/-materialien.html und
  # materialien/philosophie/-philosophie.html wieder her
  if [ -f "materialien/-materialien.sv" ]; then
    mv -f "materialien/-materialien.sv" "materialien/-materialien.html"
    mv -f "materialien/philosophie/-philosophie.sv" "materialien/philosophie/-philosophie.html"
  fi
  if [ -f "site-lib/metadata.sv" ]; then
    mv -f "site-lib/metadata.sv" "site-lib/metadata.json"
  fi
  #
  #
  # Ersetze alle Links in html Dateien in xxxstutiis von werkstatt auf xxxstutiis
  find xxxstutiis -type f -name "*.html" -print0 | xargs -0 sed -i 's/werkstatt/xxxstutiis/g'
  find xxxstutiis -type f -name "*.html" -print0 | xargs -0 sed -i 's/Werkstatt/XXXstutiis/g'
  echo "Alle Links in xxxstutiis von werkstatt auf xxxstutiis geändert"
  #
  #
  # Von jeder Dateisorte eine Datei beautifien
  .beautify_json "site-lib/metadata.json" "priv"
  .css_beautify "site-lib/styles/snippets.css" "priv"
  .js_beautify "site-lib/scripts/webpage.js" "priv"
  .html_beautify "site-lib/html/file-tree-content.html" "priv"
  .html_beautify "home.html" "priv"
  echo "beautified: s-l/metadata, /styles/snippets, /scripts/webpage, /html/file-tree-content, home"
fi
